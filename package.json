{
  "name": "loglatch",
  "version": "0.1.0",
  "description": "Local-first log triage CLI that redacts secrets, clusters failures, and writes deterministic reports.",
  "type": "module",
  "bin": {
    "loglatch": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "smoke": "npm run build && bash scripts/smoke.sh",
    "package:smoke": "npm pack --dry-run",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "logs",
    "triage",
    "cli",
    "redaction",
    "local-first",
    "ci"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/loglatch.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/loglatch/issues"
  },
  "homepage": "https://github.com/rogerchappel/loglatch#readme"
}
