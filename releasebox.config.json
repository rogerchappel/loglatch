{
  "projectType": "node-cli",
  "packageManagers": [
    "npm",
    "github-release"
  ],
  "smoke": {
    "commands": [
      ["npm", "run", "check"],
      ["npm", "test"],
      ["npm", "run", "smoke"],
      ["npm", "pack", "--dry-run"]
    ]
  },
  "release": {
    "mode": "reviewed",
    "createGithubRelease": true,
    "publishNpm": false,
    "updateHomebrew": false
  }
}
